{{#with pagination}}
{{#match pages ">" 1}}
<nav class="flex items-center justify-between py-12 border-t border-zinc-800/60 my-36 w-full text-sm font-medium"
    role="navigation" aria-label="Pagination Navigation">
    <div class="flex-1 flex justify-start">
        {{#if prev}}
        <a href="{{page_url prev}}"
            class="inline-flex items-center gap-2 rounded-lg border border-zinc-800 bg-zinc-900/40 px-4 py-2 text-zinc-300 hover:border-zinc-700 hover:text-white transition-colors">
            {{> "components/icon" name="arrow-left" class="size-4"}}
            Previous
        </a>
        {{/if}}
    </div>
    <div class="text-xs font-semibold uppercase tracking-wider text-zinc-400">
        Page {{page}} of {{pages}}
    </div>
    <div class="flex-1 flex justify-end">
        {{#if next}}
        <a href="{{page_url next}}"
            class="inline-flex items-center gap-2 rounded-lg border border-zinc-800 bg-zinc-900/40 px-4 py-2 text-zinc-300 hover:border-zinc-700 hover:text-white transition-colors">
            Next
            {{> "components/icon" name="arrow-right" class="size-4"}}
        </a>
        {{/if}}
    </div>
</nav>
{{/match}}
{{/with}}
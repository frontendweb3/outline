{{#if @custom.show_hero}}
<div class="w-full border-b border-neutral-800/60 bg-neutral-950/40 py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-4 md:px-8">
    <div class="max-w-3xl">
      <h1 class="text-4xl font-bold tracking-tight text-white md:text-6xl lg:text-7xl">
        {{#if @custom.hero_title}}{{@custom.hero_title}}{{else if @site.title}}{{@site.title}}{{else}}Learn
        Tutorials{{/if}}
      </h1>
      {{log @custom.hero_description }}
      <p class="mt-6 text-base leading-relaxed text-neutral-300 md:text-xl">
        {{#if @custom.hero_description}}{{@custom.hero_description}}
        {{else if @site.description}}
        {{@site.description}}
        {{else}}I create free YouTube tutorials and compile them here, along with the code and articles for most
        videos.{{/if}}
      </p>
    </div>
  </div>
</div>
{{/if}}
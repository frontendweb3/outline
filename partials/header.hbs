<header x-data="{ mobileMenu: false }" @keydown.escape.window="mobileMenu = false"
  class="sticky top-0 z-50 backdrop-blur-md bg-neutral-950/85 border-b border-neutral-800">
  <div class="mx-auto flex h-16 items-center justify-between px-4 md:px-8">

    <!-- Logo / Site Title -->
    <a href="{{@site.url}}" class="flex items-center gap-2.5 shrink-0 group">
      {{#if @site.logo}}
      <img class="h-8 w-auto object-contain" src="{{@site.logo}}" alt="{{@site.title}}" />
      {{/if}}
      {{#if @custom.enable_site_title}}
      <span
        class="font-mono text-lg font-bold tracking-tight text-white group-hover:text-neutral-300 transition-colors">{{@site.title}}</span>
      {{/if}}
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-6 lg:gap-8">
      {{navigation}}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-5">

      <!-- Search Toggle -->
      <button data-ghost-search="true" id="search-toggle" aria-label="Search"
        class="flex h-9 w-9 items-center justify-center rounded-xl border border-neutral-800 bg-neutral-900/60 text-neutral-400 hover:border-neutral-700 hover:text-white transition-colors cursor-pointer">
        {{> "icons/search"}}
      </button>

      <!-- Social Media Links -->
      <div class="hidden lg:flex items-center gap-3 border-l border-neutral-800 pl-3.5">
        {{#social_accounts @site}}
        <a href="{{href}}" target="_blank" rel="noopener" aria-label="{{name}}" title="{{name}}"
          class="flex h-9 w-9 items-center justify-center rounded-xl border border-neutral-800 bg-neutral-900/60 text-neutral-400 hover:border-neutral-700 hover:text-white transition-colors">
          {{#> (concat "icons/" type)}}
          <span class="text-xs font-medium">{{name}}</span>
          {{/undefined}}
        </a>
        {{/social_accounts}}
      </div>

      <!-- Member State / Buttons -->
      {{#if @member}}
      <div x-data="{ open: false }" class="relative">
        <button @click="open = !open"
          class="flex size-9 items-center justify-center rounded-full overflow-hidden border border-neutral-700 hover:border-neutral-500 transition-colors cursor-pointer">
          {{#if @member.avatar_image}}
          <img src="{{@member.avatar_image}}" alt="{{@member.name}}" class="size-full object-cover" />
          {{else}}
          <div style="background-color: {{@site.accent_color}}; color: {{contrast_text_color @site.accent_color}}"
            class="size-full flex items-center justify-center text-xs font-bold">
            {{#foreach (split @member.firstname separator="")}}
            {{#if @first}}{{this}}{{/if}}
            {{/foreach}}
          </div>
          {{/if}}
        </button>
        <div x-show="open" @click.outside="open = false" x-cloak
          class="absolute right-0 top-full mt-2 w-52 rounded-2xl border border-neutral-800 bg-neutral-950 p-2 shadow-2xl">
          <div class="px-3 py-2 border-b border-neutral-800/80 mb-1">
            <p class="text-sm font-medium text-white truncate">{{@member.name}}</p>
            <p class="text-xs text-neutral-400 truncate">{{@member.email}}</p>
          </div>
          <a href="/#/portal/account/"
            class="group flex items-center gap-2 rounded-xl px-3 py-2 text-sm text-neutral-300 hover:bg-neutral-800 hover:text-white transition-colors">
            {{> "components/icon" name="user-round" class="size-4 text-neutral-400 group-hover:text-white
            transition-colors"}}
            <span>Account</span>
          </a>
          <a href="javascript:" data-members-signout
            class="group flex items-center gap-2 rounded-xl px-3 py-2 text-sm text-neutral-300 hover:bg-neutral-800 hover:text-white transition-colors">
            {{> "components/icon" name="log-out" class="size-4 text-neutral-400 group-hover:text-white
            transition-colors"}}
            <span>Sign Out</span>
          </a>
        </div>
      </div>
      {{else}}
      <div class="hidden md:flex items-center gap-2.5">
        {{#if @custom.show_sign_in}}
        <a href="#/portal/signin"
          class="group hidden lg:inline-flex items-center gap-2 rounded-xl border border-neutral-800 bg-neutral-900/60 px-3.5 py-1.5 text-sm font-medium text-neutral-200 shadow-sm transition-all duration-300 hover:border-neutral-700 hover:bg-neutral-800 hover:text-white hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 cursor-pointer">
          {{> "components/icon" name="user-round" class="size-4 text-neutral-400 group-hover:text-white
          transition-transform duration-300 group-hover:translate-x-0.5"}}
          <span>Sign In</span>
        </a>
        {{/if}}
        {{#if @custom.show_sign_up}}
        <a href="#/portal/signup"
          class="group inline-flex items-center gap-2 rounded-xl px-3.5 py-1.5 text-sm font-medium text-white shadow-sm transition-all duration-300 hover:opacity-90 hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 cursor-pointer"
          style="background-color: {{@site.accent_color}}; color: {{contrast_text_color @site.accent_color}}">
          <span>Sign Up</span>
          {{> "components/icon" name="send-horizontal" class="size-4 transition-transform duration-300
          group-hover:translate-x-1"}}
        </a>
        {{/if}}
      </div>
      {{/if}}

      <!-- Mobile Menu Button -->
      <button type="button"
        class="flex h-9 w-9 items-center justify-center rounded-xl border border-neutral-800 bg-neutral-900/60 text-neutral-400 md:hidden hover:text-white cursor-pointer"
        @click="mobileMenu = !mobileMenu" aria-label="Toggle navigation menu">
        <svg x-show="!mobileMenu" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg x-show="mobileMenu" x-cloak class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div x-show="mobileMenu" x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2" x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-2" x-cloak
    class="md:hidden border-t border-neutral-800 bg-neutral-950 px-4 py-6 shadow-2xl">
    <nav class="flex flex-col gap-4 text-center">
      {{navigation}}
    </nav>
    <div class="mt-6 flex items-center justify-center gap-3 border-t border-neutral-800 pt-4">
      {{#social_accounts @site}}
      <a href="{{href}}" target="_blank" rel="noopener" aria-label="{{name}}" title="{{name}}"
        class="flex h-9 w-9 items-center justify-center rounded-xl border border-neutral-800 bg-neutral-900/50 text-neutral-400 hover:text-white transition-colors">
        {{#> (concat "icons/" type)}}
        <span class="text-xs">{{name}}</span>
        {{/undefined}}
      </a>
      {{/social_accounts}}
    </div>
    {{#unless @member}}
    <div class="mt-6 flex flex-col gap-2.5">
      {{#if @custom.show_sign_up}}
      <a href="#/portal/signup"
        class="group inline-flex w-full items-center justify-center gap-2 rounded-xl py-2.5 text-center text-sm font-medium text-white shadow-sm transition-all duration-300 hover:opacity-90 hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 cursor-pointer"
        style="background-color: {{@site.accent_color}}; color: {{contrast_text_color @site.accent_color}}">
        <span>Sign Up</span>
        {{> "components/icon" name="send-horizontal" class="size-4 transition-transform duration-300
        group-hover:translate-x-1"}}
      </a>
      {{/if}}
      {{#if @custom.show_sign_in}}
      <a href="#/portal/signin"
        class="group inline-flex w-full items-center justify-center gap-2 rounded-xl border border-neutral-800 bg-neutral-900/60 py-2.5 text-center text-sm font-medium text-neutral-200 shadow-sm transition-all duration-300 hover:border-neutral-700 hover:bg-neutral-800 hover:text-white hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 cursor-pointer">
        {{> "components/icon" name="user-round" class="size-4 text-neutral-400 group-hover:text-white transition-colors
        duration-300"}}
        <span>Sign In</span>
      </a>
      {{/if}}
    </div>
    {{/unless}}
  </div>
</header>
{{#with pagination}}
{{#match pages ">" 1}}
<div class="flex justify-center items-center gap-4 py-12 border-t border-zinc-800/60 my-36 w-full text-sm font-medium">
    {{#if prev}}
    <a href="{{page_url prev}}"
        class="inline-flex items-center gap-2 rounded-lg border border-zinc-800 bg-zinc-900/40 px-5 py-2.5 text-zinc-300 hover:border-zinc-700 hover:text-white transition-colors">
        {{> "components/icon" name="arrow-left" class="size-4"}}
        Previous
    </a>
    {{/if}}
    {{#if next}}
    <a href="{{page_url next}}"
        class="inline-flex items-center gap-2 rounded-lg border border-zinc-800 bg-zinc-900/40 px-5 py-2.5 text-zinc-300 hover:border-zinc-700 hover:text-white transition-colors">
        Next
        {{> "components/icon" name="arrow-right" class="size-4"}}
    </a>
    {{/if}}
</div>
{{/match}}
{{/with}}
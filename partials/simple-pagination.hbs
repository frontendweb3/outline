{{#with pagination}}
{{#match pages ">" 1}}
<nav class="my-36 flex w-full items-center justify-center gap-4 pt-8 text-sm font-medium" role="navigation"
    aria-label="Simple Pagination Navigation">
    {{#if prev}}
    <a href="{{page_url prev}}"
        class="group inline-flex items-center gap-2.5 rounded-xl border border-border/80 bg-card/60 px-5 py-2.5 text-muted-foreground transition-all duration-300 hover:border-primary/50 hover:bg-accent hover:text-foreground hover:shadow-sm"
        aria-label="Go to previous page">
        {{> "components/icon" name="arrow-left" class="size-4 transition-transform duration-300 ease-out
        group-hover:-translate-x-1"}}
        <span>Previous</span>
    </a>
    {{/if}}
    {{#if next}}
    <a href="{{page_url next}}"
        class="group inline-flex items-center gap-2.5 rounded-xl border border-border/80 bg-card/60 px-5 py-2.5 text-muted-foreground transition-all duration-300 hover:border-primary/50 hover:bg-accent hover:text-foreground hover:shadow-sm"
        aria-label="Go to next page">
        <span>Next</span>
        {{> "components/icon" name="arrow-right" class="size-4 transition-transform duration-300 ease-out
        group-hover:translate-x-1"}}
    </a>
    {{/if}}
</nav>
{{/match}}
{{/with}}
<div class="mx-auto max-w-7xl my-12 px-4 md:px-8 pt-8 pb-4">
    <nav aria-label="Tag filter" class="flex items-center gap-3.5 overflow-x-auto py-3 px-1">
        <a href="{{@site.url}}"
            class="shrink-0 rounded-xl bg-neutral-100 px-4 py-2 text-sm font-semibold text-neutral-900 shadow-sm transition-opacity hover:opacity-90">
            All Tutorials
        </a>
        {{#get "tags" limit="5" order="count.posts desc" include="count.posts"}}
        {{#foreach tags}}
        {{#if count.posts}}
        <a href="{{url}}"
            class="relative shrink-0 min-w-18 text-center rounded-xl border border-neutral-800 bg-neutral-900/60 px-4 py-2 text-sm font-medium text-neutral-300 transition-colors hover:border-neutral-700 hover:bg-neutral-800 hover:text-white">
            <span>{{name}}</span>
            <span
                class="absolute -top-2 -right-2 flex h-5 min-w-5 items-center justify-center rounded-full bg-neutral-100 px-1 text-[10px] font-bold text-neutral-950 shadow-sm ring-2 ring-neutral-950">
                {{count.posts}}
            </span>
        </a>
        {{/if}}
        {{/foreach}}
        {{/get}}
    </nav>
</div>
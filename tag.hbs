{{!< default}} {{#tag}} <div class="w-full border-b border-neutral-800/60 bg-[#110f0e] py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-4 md:px-8">
    <div class="max-w-3xl">

      <h1 class="text-3xl font-bold tracking-tight text-white md:text-5xl lg:text-6xl">
        {{name}}
      </h1>

      {{#if description}}
      <p class="mt-4 text-base leading-relaxed text-neutral-300 md:text-xl">
        {{description}}
      </p>
      {{else}}
      <p class="mt-4 text-base text-neutral-400 md:text-lg">
        A collection of {{plural ../pagination.total empty="0 posts" single="1 post" plural="% posts"}}
      </p>
      {{/if}}
    </div>
  </div>
  </div>
  {{/tag}}
  <section class="mx-auto max-w-7xl px-4 md:px-8 py-10">
    {{> "posts-grid"}}

    {{#match @custom.pagination_style "simple"}}
    {{> "simple-pagination"}}
    {{else}}
    {{> "pagination"}}
    {{/match}}
  </section>
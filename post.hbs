{{!< default}} {{#post}} <article class="w-full">

  <!-- Post Header -->
  <header class="mx-auto pt-10 md:pt-12 bg-[#110f0e] px-4 md:px-8">
    <div class="mx-auto max-w-4xl">

      <!-- Feature Image on Top -->
      {{#if feature_image}}
      <figure class="mb-8 md:mb-10">
        <div class="overflow-hidden border border-neutral-800 shadow-2xl">
          <img class="w-full object-cover max-h-140" srcset="{{img_url feature_image size=" s"}} 300w, {{img_url
            feature_image size="m" }} 600w, {{img_url feature_image size="l" }} 1000w, {{img_url feature_image size="xl"
            }} 2000w" sizes="(max-width: 1000px) 100vw, 1000px" src="{{img_url feature_image size=" l"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="eager" />
        </div>
        {{#if feature_image_caption}}
        <figcaption class="mt-3.5 text-center text-xs text-neutral-400">
          {{feature_image_caption}}
        </figcaption>
        {{/if}}
      </figure>
      {{/if}}

      {{#if primary_tag}}
      {{#primary_tag}}
      <a href="{{url}}"
        class="inline-flex items-center gap-3 rounded-full px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-neutral-300 hover:border-neutral-700 hover:text-white transition-colors">
        {{> "components/icon" name="tag" class="size-4" }}
        <span>{{name}}</span>
      </a>
      {{/primary_tag}}
      {{/if}}

      <h1 class="mt-4 text-3xl font-bold tracking-tight text-white leading-[1.15] md:text-5xl lg:text-6xl">
        {{title}}
      </h1>

      {{#if custom_excerpt}}
      <p class="mt-6 text-lg leading-relaxed text-neutral-300 md:text-xl">
        {{custom_excerpt}}
      </p>
      {{/if}}

      <!-- Meta Bar -->
      <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-y border-neutral-800/80 py-4">
        <div class="flex items-center gap-3">
          <div class="flex -space-x-2 overflow-hidden">
            {{#foreach authors}}
            {{#if profile_image}}
            <img src="{{img_url profile_image size=" xs"}}" alt="{{name}}"
              class="size-10 rounded-full object-cover ring-2 ring-neutral-950" />
            {{/if}}
            {{/foreach}}
          </div>
          <div class="flex flex-col text-sm">
            <span class="font-medium text-white">
              {{#foreach authors}}<a href="{{url}}" class="hover:underline">{{name}}</a>{{#if @last}}{{else}},
              {{/if}}{{/foreach}}
            </span>
            <div class="flex flex-wrap items-center gap-2 text-xs text-neutral-400">
              <span class="inline-flex items-center gap-1">
                {{> "components/icon" name="calendar" class="size-3.5 text-neutral-400"}}
                <time datetime="{{date published_at format=" YYYY-MM-DD"}}">{{date published_at format="DD MMMM
                  YYYY"}}</time>
              </span>
              <span>&middot;</span>
              <span class="inline-flex items-center gap-1">
                {{> "components/icon" name="clock" class="size-3.5 text-neutral-400"}}
                <span>{{reading_time minute="1 min read" minutes="% min read"}}</span>
              </span>
            </div>
          </div>
        </div>

        <!-- Share Actions -->
        <div class="hidden sm:flex items-center gap-2">
          <a href="https://twitter.com/share?text={{encode title}}&amp;url={{url absolute=" true"}}" target="_blank"
            rel="noopener" aria-label="Share on X" title="Share on X"
            class="flex h-9 w-9 items-center justify-center rounded-xl border border-neutral-800 bg-neutral-900/60 text-neutral-400 hover:border-neutral-700 hover:text-white transition-colors">
            {{> "icons/x"}}
          </a>
          <a href="https://www.linkedin.com/sharing/share-offsite/?url={{url absolute=" true"}}" target="_blank"
            rel="noopener" aria-label="Share on LinkedIn" title="Share on LinkedIn"
            class="flex h-9 w-9 items-center justify-center rounded-xl border border-neutral-800 bg-neutral-900/60 text-neutral-400 hover:border-neutral-700 hover:text-white transition-colors">
            {{> "icons/linkedin"}}
          </a>
          <a href="https://www.facebook.com/sharer/sharer.php?u={{url absolute=" true"}}" target="_blank" rel="noopener"
            aria-label="Share on Facebook" title="Share on Facebook"
            class="flex h-9 w-9 items-center justify-center rounded-xl border border-neutral-800 bg-neutral-900/60 text-neutral-400 hover:border-neutral-700 hover:text-white transition-colors">
            {{> "icons/facebook"}}
          </a>
          <a href="/#/share" aria-label="Share on Social Media" title="Share on Social Media"
            class="flex h-9 w-9 items-center justify-center rounded-xl border border-neutral-800 bg-neutral-900/60 text-neutral-400 hover:border-neutral-700 hover:text-white transition-colors">
            {{> "components/icon" name="share2" ariaLabel="Share on Social Media" class="size-4.5"}}
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Article Body -->
  <div class="mx-auto mt-16 max-w-7xl px-4 md:px-8">
    <div
      class="prose prose-lg prose-invert mx-auto mb-16 max-w-3xl prose-headings:font-bold prose-headings:tracking-tight prose-a:text-primary hover:prose-a:opacity-80 prose-code:rounded-md prose-code:bg-neutral-900 prose-code:border prose-code:border-neutral-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:text-sm prose-pre:border prose-pre:border-neutral-800 prose-pre:bg-neutral-950">
      {{content}}
    </div>
  </div>

  <!-- Share & Social Accounts Footer Bar -->
  <section class="mx-auto max-w-3xl my-12">

    <div
      class="flex flex-col md:flex-row md:items-center justify-between gap-6 border border-neutral-800/80 bg-linear-to-br from-neutral-900/80 via-neutral-900/40 to-neutral-950/90 p-6 md:p-8 backdrop-blur-md shadow-2xl">


      <div class="space-y-1">
        <h3 class="text-lg font-bold text-white tracking-tight">Enjoyed reading this article?</h3>
        <p class="text-xs text-neutral-400">Share it with your community or connect with us on social media.</p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <!-- Post Direct Share Links -->
        <div class="flex items-center gap-2">
          <button x-data="{ copied: false }"
            @click="navigator.clipboard.writeText(window.location.href); copied = true; setTimeout(() => copied = false, 2000)"
            class="relative flex h-9 w-9 items-center justify-center gap-1.5 rounded-xl border border-neutral-800 bg-neutral-900/60 
             text-xs font-medium text-neutral-400 hover:border-neutral-700
              hover:text-white transition-all duration-300 hover:scale-[1.02] cursor-pointer" title="Copy Link">
            <span x-show="!copied" class="flex items-center gap-1.5">
              {{> "components/icon" name="copy" class="size-4"}}
            </span>
            <span x-show="copied" x-cloak class="flex items-center gap-1.5 text-emerald-400 font-semibold">
              {{> "components/icon" name="check-check" class="size-4 text-emerald-400"}}
            </span>
          </button>
          <a href="/#/share" aria-label="Share Options" title="Share Options"
            class="flex h-9 w-9 items-center justify-center rounded-xl border border-neutral-800 bg-neutral-900/60 text-neutral-400 hover:border-neutral-700 hover:text-white transition-all duration-300 hover:scale-105">
            {{> "components/icon" name="share2" class="size-4.5"}}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Prev / Next Navigation -->
  <nav
    class="mx-auto flex flex-col sm:flex-row w-full max-w-3xl items-center justify-between gap-12 sm:gap-6 px-4 md:px-8 my-12 border-t border-neutral-800/80 pt-8">
    <div class="flex-1">
      {{#prev_post}}
      <a href="{{url}}" class="group flex flex-col items-start gap-1">
        <span
          class="flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-neutral-400 transition-colors group-hover:text-white">
          &larr; Previous Post
        </span>
        <span
          class="text-base font-medium text-neutral-300 transition-colors group-hover:text-white line-clamp-1">{{title}}</span>
      </a>
      {{/prev_post}}
    </div>
    <div class="text-right flex-1">
      {{#next_post}}
      <a href="{{url}}" class="group flex flex-col items-end gap-1">
        <span
          class="flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-neutral-400 transition-colors group-hover:text-white">
          Next Post &rarr;
        </span>
        <span
          class="text-base font-medium text-neutral-300 transition-colors group-hover:text-white line-clamp-1">{{title}}</span>
      </a>
      {{/next_post}}
    </div>
  </nav>

  <!-- Related Posts -->
  {{#if primary_tag}}
  {{#get "posts" limit="3" include="tags,authors" filter="tags:{{primary_tag.slug}}+id:-{{id}}" as |related|}}
  {{#if related}}
  <section class="mx-auto w-full max-w-7xl px-4 md:px-8 pt-12 border-t border-neutral-800/80">
    <h2 class="mb-6 text-2xl font-bold text-white tracking-tight">Related Articles</h2>
    <div class="mt-8">
      {{> "posts-grid" posts=related}}
    </div>
  </section>
  {{/if}}
  {{/get}}
  {{/if}}

  <!-- Comments -->
  {{#if comments}}
  <section class="mx-auto max-w-3xl mt-28 px-4 md:px-8 pt-12">
    {{comments}}
  </section>
  {{/if}}
  </article>
  {{/post}}
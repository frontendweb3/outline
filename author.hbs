{{!< default}} {{#author}} <div class="w-full border-b border-neutral-800/60 bg-[#110f0e] py-24 md:py-32">
    <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="max-w-6xl">

            <div class="flex flex-col gap-6 sm:flex-row sm:items-center">

                {{#if profile_image}}
                <img src="{{img_url profile_image size=" s"}}" alt="{{name}}" loading="eager"
                    class="size-28 shrink-0 rounded-full border-2 border-neutral-800 object-cover md:size-32" />
                {{else}}
                <div
                    class="flex size-20 shrink-0 items-center justify-center rounded-full border-2 border-neutral-800 bg-neutral-900 text-2xl font-bold text-neutral-300 md:size-24">
                    {{#foreach (split name separator=" ")}}
                    {{#if @first}}{{this}}{{/if}}
                    {{/foreach}}
                </div>
                {{/if}}

                <div>
                    <h1 class="text-3xl font-bold tracking-tight text-white md:text-4xl lg:text-5xl">
                        {{name}}
                    </h1>

                    {{#if bio}}
                    <p class="mt-2 text-base leading-relaxed text-neutral-300 md:text-lg">
                        {{bio}}
                    </p>
                    {{/if}}

                    <div class="mt-4 flex flex-wrap items-center gap-2.5">

                        {{#if website}}
                        <a href="{{website}}" target="_blank" rel="noopener" aria-label="Website" title="Website"
                            class="flex size-9 items-center justify-center rounded-xl border border-neutral-800 bg-neutral-900/60 text-neutral-400 transition-colors hover:border-neutral-700 hover:text-white">
                            {{> "components/icon" name="globe"}}
                        </a>
                        {{/if}}

                        {{#social_accounts this}}
                        <a href="{{href}}" target="_blank" rel="noopener" aria-label="{{name}}" title="{{name}}"
                            class="flex size-9 items-center justify-center rounded-xl border border-neutral-800 bg-neutral-900/60 text-neutral-400 transition-colors hover:border-neutral-700 hover:text-white">
                            {{#> (concat "icons/" type)}}
                            <span class="text-xs">{{name}}</span>
                            {{/undefined}}
                        </a>
                        {{/social_accounts}}
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
    {{/author}}

    <section class="mx-auto max-w-7xl px-4 md:px-8 py-10">
        {{> "posts-grid"}}

        {{#match @custom.pagination_style "simple"}}
        {{> "simple-pagination"}}
        {{else}}
        {{> "pagination"}}
        {{/match}}
    </section>